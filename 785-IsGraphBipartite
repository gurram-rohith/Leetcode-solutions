1class Solution {
2public:
3    bool dfs(vector<vector<int>>&graph,vector<int>&clr,int c,vector<bool>&vis,int ele){
4        vector<int>adj=graph[ele];
5        bool f=true;
6        clr[ele]=c;
7        vis[ele]=true;
8        for(int i:adj)
9        {
10            if(vis[i])
11            {
12                if(clr[i]!=c) continue;
13                return false;
14            }
15            else
16            {
17                f&=dfs(graph,clr,!c,vis,i);
18            }
19        }
20        return f;
21    }
22    bool isBipartite(vector<vector<int>>& graph) {
23        int n=graph.size();
24        vector<bool>vis(n+1,false);
25        bool f=true;
26        vector<int>clr(n+1,0);
27        for(int i=0;i<n;i++)
28        {
29            if(!vis[i]) f&=dfs(graph,clr,0,vis,i);
30        }
31        return f;
32    }
33};